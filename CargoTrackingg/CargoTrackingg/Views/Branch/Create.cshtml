@model CargoTrackingg.Models.Branch

@{
    ViewData["Title"] = "Add New Branch";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <!-- Title -->
    <div class="tracking-status">
        <h2>Add New Branch</h2>
    </div>

    <!-- Form -->
    <div class="form-container">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Name"></label>
                <input asp-for="Name" class="form-control" placeholder="Enter branch name" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="City"></label>
                <input asp-for="City" class="form-control" placeholder="Enter city name" />
                <span asp-validation-for="City" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Address"></label>
                <textarea asp-for="Address" class="form-control" placeholder="Enter full address"></textarea>
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>

            <button type="submit" class="submit-btn">Save</button>
            <a asp-action="Index" class="btn btn-secondary mt-3">Cancel</a>
        </form>
    </div>
</div>

<!-- Orange Theme Style -->
<style>
    .tracking-status {
        background: linear-gradient(135deg, #FF7F11 0%, #FFAA00 100%);
        color: white;
        padding: 40px;
        border-radius: 25px;
        margin-bottom: 40px;
        text-align: center;
        box-shadow: 0 30px 60px rgba(0,0,0,0.2);
    }

    .form-container {
        background-color: #ffffff;
        border-radius: 25px;
        padding: 40px;
        box-shadow: 0 30px 60px rgba(0,0,0,0.15);
        margin-bottom: 40px;
    }

    .form-group {
        margin-bottom: 25px;
    }

        .form-group label {
            font-weight: bold;
            color: #FF7F11;
            margin-bottom: 10px;
            display: block;
        }

        .form-group input,
        .form-group textarea {
            width: 100%;
            padding: 15px;
            border-radius: 15px;
            border: 1px solid #dddddd;
            font-size: 16px;
            background-color: #f5f5f5;
            transition: box-shadow 0.3s ease, border-color 0.3s ease;
        }

            .form-group input:focus,
            .form-group textarea:focus {
                box-shadow: 0 15px 30px rgba(0,0,0,0.15);
                border-color: #FF7F11;
            }

        .form-group textarea {
            height: 120px;
            resize: none;
        }

    .submit-btn {
        background-color: #FF7F11;
        color: white;
        font-weight: bold;
        padding: 15px 30px;
        border: none;
        border-radius: 30px;
        cursor: pointer;
        font-size: 18px;
        width: 100%;
        box-shadow: 0 15px 30px rgba(255, 127, 17, 0.4);
        transition: background-color 0.3s ease, box-shadow 0.3s ease;
    }

        .submit-btn:hover {
            background-color: #FFAA00;
            box-shadow: 0 20px 40px rgba(255, 127, 17, 0.6);
        }
</style>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
