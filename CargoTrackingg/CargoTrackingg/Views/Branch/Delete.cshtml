@model CargoTrackingg.Models.Branch

<h2>Şube Sil</h2>

<h4>Bu şubeyi silmek istediğinizden emin misiniz?</h4>

<dl class="row">
    <dt class="col-sm-2">Şube Adı</dt>
    <dd class="col-sm-10">@Model.Name</dd>

    <dt class="col-sm-2">Şehir</dt>
    <dd class="col-sm-10">@Model.City</dd>

    <dt class="col-sm-2">Adres</dt>
    <dd class="col-sm-10">@Model.Address</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Sil</button>
    <a asp-action="Index" class="btn btn-secondary">İptal</a>
</form>
