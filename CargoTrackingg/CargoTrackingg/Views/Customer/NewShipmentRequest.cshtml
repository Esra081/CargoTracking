@{
    ViewData["Title"] = "New Shipment Request";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container">
    <!-- Page Title -->
    <div class="tracking-status">
        <h2>New Shipment Request</h2>
    </div>

    <!-- New Shipment Request Form -->
    <div class="form-container">
        <form method="post" action="/Customer/NewShipmentRequest">
            <div class="form-group">
                <label for="senderName">Sender Name</label>
                <input type="text" id="senderName" name="senderName" placeholder="Enter sender's full name" required>
            </div>
            <div class="form-group">
                <label for="receiverName">Receiver Name</label>
                <input type="text" id="receiverName" name="receiverName" placeholder="Enter receiver's full name" required>
            </div>
            <div class="form-group">
                <label for="pickupAddress">Pickup Address</label>
                <textarea id="pickupAddress" name="pickupAddress" placeholder="Enter pickup address" required></textarea>
            </div>
            <div class="form-group">
                <label for="deliveryAddress">Delivery Address</label>
                <textarea id="deliveryAddress" name="deliveryAddress" placeholder="Enter delivery address" required></textarea>
            </div>
            <div class="form-group">
                <label for="packageWeight">Package Weight (kg)</label>
                <input type="number" id="packageWeight" name="packageWeight" placeholder="Enter package weight" required>
            </div>
            <div class="form-group">
                <label for="description">Package Description</label>
                <textarea id="description" name="description" placeholder="Enter package description" required></textarea>
            </div>
            <button type="submit" class="submit-btn">Submit Request</button>
        </form>
    </div>
</div>

<<style>
     /* New Shipment Request Styles */
     .tracking-status {
         background-image: linear-gradient(135deg, #FF7F11 0%, #FFAA00 100%);
         color: white;
         padding: 40px;
         border-radius: 25px;
         margin-bottom: 40px;
         box-shadow: 0 30px 60px rgba(0,0,0,0.2);
         position: relative;
         overflow: hidden;
     }

         .tracking-status h2 {
             font-size: 36px;
             margin-bottom: 20px;
             text-shadow: 2px 2px 8px rgba(0,0,0,0.3);
         }

     .form-container {
         background-color: #ffffff;
         border-radius: 25px;
         padding: 40px;
         box-shadow: 0 30px 60px rgba(0,0,0,0.15);
         margin-bottom: 40px;
     }

     .form-group {
         margin-bottom: 25px;
     }

         .form-group label {
             font-weight: bold;
             color: #FF7F11;
             margin-bottom: 10px;
             display: block;
         }

         /* Gri Yazı Kutuları */
         .form-group input, .form-group textarea, .form-group select {
             width: 100%;
             padding: 15px;
             border-radius: 15px;
             border: 1px solid #dddddd;
             font-size: 16px;
             color: #444444;
             background-color: #f5f5f5; /* Gri renk */
             transition: box-shadow 0.3s ease, border-color 0.3s ease;
         }

             .form-group input:focus, .form-group textarea:focus, .form-group select:focus {
                 box-shadow: 0 15px 30px rgba(0,0,0,0.15);
                 border-color: #FF7F11;
             }

         /* Daha Yumuşak Gölge ve Köşe Yuvarlama */
         .form-group textarea {
             height: 150px;
             resize: none;
         }

     /* Submit Button */
     .submit-btn {
         background-color: #FF7F11;
         color: white;
         font-weight: bold;
         padding: 15px 30px;
         border: none;
         border-radius: 30px;
         cursor: pointer;
         font-size: 18px;
         text-transform: uppercase;
         transition: background-color 0.3s ease, box-shadow 0.3s ease;
         width: 100%;
         box-shadow: 0 15px 30px rgba(255, 127, 17, 0.4);
     }

         .submit-btn:hover {
             background-color: #FFAA00;
             box-shadow: 0 20px 40px rgba(255, 127, 17, 0.6);
         }
</style>