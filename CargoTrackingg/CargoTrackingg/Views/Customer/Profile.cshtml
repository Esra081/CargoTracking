@model CargoTrackingg.ViewModels.CustomerProfileViewModel

@{
    ViewData["Title"] = "Customer Profile - CargoTrackingg";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container">
    <div class="tracking-status">
        <h2>MY PROFILE</h2>
    </div>

    <div class="form-container">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success text-center mt-4">
                @TempData["SuccessMessage"]
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger text-center mt-4">
                @TempData["ErrorMessage"]
            </div>
        }

        <form asp-action="Profile" method="post">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label>Full Name</label>
                <input asp-for="FullName" class="form-control" placeholder="Enter your full name" required>
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Email</label>
                <input asp-for="Email" class="form-control" readonly>
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Phone Number</label>
                <input asp-for="PhoneNumber" id="PhoneNumber" class="form-control" placeholder="Enter your phone number" required>
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Address</label>
                <textarea asp-for="Address" class="form-control" placeholder="Enter your address"></textarea>
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>

            <button type="submit" class="submit-btn">SAVE CHANGES</button>
        </form>
    </div>
</div>

<style>
    /* Page Header */
    .tracking-status {
        background-image: linear-gradient(135deg, #FF7F11 0%, #FFAA00 100%);
        color: white;
        padding: 40px;
        border-radius: 25px;
        margin-bottom: 40px;
        box-shadow: 0 30px 60px rgba(0,0,0,0.2);
        text-align: center;
        font-family: 'Roboto', sans-serif;
    }

    /* Form Container */
    .form-container {
        background-color: #ffffff;
        border-radius: 25px;
        padding: 40px;
        box-shadow: 0 30px 60px rgba(0,0,0,0.15);
        margin-bottom: 40px;
        font-family: 'Roboto', sans-serif;
    }

    /* Gri Yazı Kutuları */
    .form-group input, .form-group textarea {
        width: 100%;
        padding: 15px;
        border-radius: 15px;
        border: 1px solid #dddddd;
        font-size: 16px;
        color: #444444;
        background-color: #f5f5f5;
        box-shadow: 0 10px 20px rgba(0,0,0,0.05);
        transition: box-shadow 0.3s ease, border-color 0.3s ease;
    }

        /* Odak (Focus) Efekti */
        .form-group input:focus, .form-group textarea:focus {
            box-shadow: 0 15px 30px rgba(0,0,0,0.15);
            border-color: #FF7F11;
        }

    /* Form Labels */
    .form-group label {
        font-weight: bold;
        color: #FF7F11;
        margin-bottom: 10px;
        display: block;
        font-size: 18px;
    }

    /* Submit Button */
    .submit-btn {
        background-color: #FF7F11;
        color: white;
        font-weight: bold;
        padding: 15px 30px;
        border: none;
        border-radius: 30px;
        cursor: pointer;
        font-size: 18px;
        text-transform: uppercase;
        transition: background-color 0.3s ease, box-shadow 0.3s ease;
        width: 100%;
        box-shadow: 0 15px 30px rgba(255, 127, 17, 0.4);
    }

        .submit-btn:hover {
            background-color: #FFAA00;
            box-shadow: 0 20px 40px rgba(255, 127, 17, 0.6);
        }
</style>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const phoneInput = document.getElementById("PhoneNumber");

        phoneInput.addEventListener("input", function () {
            let number = phoneInput.value.replace(/\D/g, ""); // Sadece sayıları al
            if (number.startsWith("90")) number = number.substring(2); // +90 başlangıcını kaldır

            if (number.length > 0) number = "+90 (" + number;
            if (number.length > 8) number = number.substring(0, 8) + ") " + number.substring(8);
            if (number.length > 13) number = number.substring(0, 13) + " " + number.substring(13);
            if (number.length > 16) number = number.substring(0, 16) + " " + number.substring(16);

            phoneInput.value = number.substring(0, 19); // Maksimum 19 karakter
        });
    });
</script>
