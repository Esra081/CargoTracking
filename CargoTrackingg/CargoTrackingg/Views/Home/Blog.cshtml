@{
    ViewData["Title"] = "Blog";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - CargoTrackingg</title>
    <link href="https://fonts.googleapis.com/css2?family=Rubik:wght@300;400;700&display=swap" rel="stylesheet" />
    <link href="/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/css/style.css" rel="stylesheet" />
    <style>
        .blog-hero {
            background-image: url('/images/WhatsApp Image 2025-05-17 at 20.20.32.jpeg');
            background-size: cover;
            background-position: center;
            height: 500px;
            color: #ffffff;
        }

            .blog-hero h1 {
                font-size: 4rem;
                font-weight: 700;
                text-shadow: 2px 2px 10px rgba(0,0,0,0.5);
            }

            .blog-hero p {
                font-size: 1.25rem;
                text-shadow: 1px 1px 5px rgba(0,0,0,0.5);
            }
    </style>
</head>
<body>
    <section class="blog-hero d-flex flex-column justify-content-center">
        <div class="container">
            <h1 class="display-4">Our Blog</h1>
            <p class="lead">Stay updated with the latest news and insights from the world of logistics.</p>
        </div>
    </section>

    <section class="blog-section py-5 bg-light">
        <div class="container">
            <div class="row">
                <div class="col-md-6 mb-4">
                    <h2>Latest Articles</h2>
                    <p>Explore industry trends, tips, and success stories from our experts.</p>
                </div>
                <div class="col-md-6 mb-4">
                    <img src="/images/WhatsApp Image 2025-05-17 at 20.20.28.jpeg" class="img-fluid rounded shadow-lg" alt="Latest News">
                </div>
            </div>
        </div>
    </section>



    <script src="/js/jquery-3.3.1.min.js"></script>
    <script src="/js/bootstrap.bundle.min.js"></script>
    <script src="/js/site.js"></script>
</body>
</html>