@{
    ViewData["Title"] = "Privacy";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - CargoTrackingg</title>
    <link href="https://fonts.googleapis.com/css2?family=Rubik:wght@300;400;700&display=swap" rel="stylesheet" />
    <link href="/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/css/style.css" rel="stylesheet" />
    <style>
        .privacy-hero {
            background-image: url('/images/cargo_delivery_big.jpg');
            background-size: cover;
            background-position: center;
            height: 500px;
            color: #ffffff;
        }

            .privacy-hero h1 {
                font-size: 4rem;
                font-weight: 700;
                text-shadow: 2px 2px 10px rgba(0,0,0,0.5);
            }

            .privacy-hero p {
                font-size: 1.25rem;
                text-shadow: 1px 1px 5px rgba(0,0,0,0.5);
            }
    </style>
</head>
<body>
    <section class="privacy-hero d-flex flex-column justify-content-center">
        <div class="container">
            <h1 class="display-4">Privacy Policy</h1>
            <p class="lead">Understand how we protect your data and ensure your privacy.</p>
        </div>
    </section>

    <section class="privacy-section py-5 bg-light">
        <div class="container">
            <div class="row">
                <div class="col-md-12 mb-4">
                    <h2>Our Commitment to Privacy</h2>
                    <p>We take your privacy seriously and are committed to safeguarding your personal information. Our privacy policy outlines how we collect, use, and protect your data.</p>
                    <p>We comply with all relevant data protection regulations to ensure your information is secure.</p>
                </div>
            </div>
        </div>
    </section>



    <script src="/js/jquery-3.3.1.min.js"></script>
    <script src="/js/bootstrap.bundle.min.js"></script>
    <script src="/js/site.js"></script>
</body>
</html>