@{
    ViewData["Title"] = "Services";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - CargoTrackingg</title>
    <link href="https://fonts.googleapis.com/css2?family=Rubik:wght@300;400;700&display=swap" rel="stylesheet">
    <link href="/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/css/style.css" rel="stylesheet" />
    <style>
        .services-hero {
            background-image: url('/images/WhatsApp Image 2025-05-17 at 20.25.49.jpeg');
            background-size: cover;
            background-position: center;
            height: 500px;
            color: #ffffff;
        }

            .services-hero h1 {
                font-size: 4rem;
                font-weight: 700;
                text-shadow: 2px 2px 10px rgba(0,0,0,0.5);
            }

            .services-hero p {
                font-size: 1.25rem;
                text-shadow: 1px 1px 5px rgba(0,0,0,0.5);
            }
    </style>
</head>
<body>
    <section class="services-hero d-flex flex-column justify-content-center">
        <div class="container">
            <h1 class="display-4">Our Services</h1>
            <p class="lead">Explore our wide range of logistics and cargo management solutions.</p>
        </div>
    </section>

    <section class="services-section py-5 bg-light">
        <div class="container">
            <div class="row text-center">
                <div class="col-md-4 mb-4">
                    <div class="card shadow-lg border-0">
                        <img src="/images/WhatsApp Image 2025-05-17 at 20.25.59.jpeg" class="card-img-top" alt="Same Day Delivery Across the Country">
                        <div class="card-body">
                            <h5 class="card-title">Same Day Delivery</h5>
                            <p class="card-text">Guaranteed same-day delivery for all your critical shipments.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 mb-4">
                    <div class="card shadow-lg border-0">
                        <img src="/images/WhatsApp Image 2025-05-17 at 20.26.20.jpeg" class="card-img-top" alt="Fully Insured Shipments">
                        <div class="card-body">
                            <h5 class="card-title">Fully Insured Shipments</h5>
                            <p class="card-text">Safe and reliable cargo handling with real-time tracking.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 mb-4">
                    <div class="card shadow-lg border-0">
                        <img src="/images/WhatsApp Image 2025-05-17 at 20.26.36.jpeg" class="card-img-top" alt="24/7 Support">
                        <div class="card-body">
                            <h5 class="card-title">24/7 Support</h5>
                            <p class="card-text">Round-the-clock customer support for all your logistics needs..</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>



    <script src="/js/jquery-3.3.1.min.js"></script>
    <script src="/js/bootstrap.bundle.min.js"></script>
    <script src="/js/site.js"></script>
</body>
</html>