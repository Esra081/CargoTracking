@{
    ViewData["Title"] = "Why Us";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - CargoTrackingg</title>
    <link href="https://fonts.googleapis.com/css2?family=Rubik:wght@300;400;700&display=swap" rel="stylesheet" />
    <link href="/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/css/style.css" rel="stylesheet" />
    <style>
        .why-us-hero {
            background-image: url('/images/WhatsApp Image 2025-05-17 at 20.28.44.jpeg');
            background-size: cover;
            background-position: center;
            height: 500px;
            color: #ffffff;
        }

            .why-us-hero h1 {
                font-size: 4rem;
                font-weight: 700;
                text-shadow: 2px 2px 10px rgba(0,0,0,0.5);
            }

            .why-us-hero p {
                font-size: 1.25rem;
                text-shadow: 1px 1px 5px rgba(0,0,0,0.5);
            }
    </style>
</head>
<body>
    <section class="why-us-hero d-flex flex-column justify-content-center">
        <div class="container">
            <h1 class="display-4">Why Us</h1>
            <p class="lead">Discover why businesses choose us for their logistics and cargo needs.</p>
        </div>
    </section>

    <section class="why-us-section py-5 bg-light">
        <div class="container">
            <div class="row text-center">
                <div class="col-md-6 mb-4">
                    <h2>Why Choose Us?</h2>
                    <p>We provide fast, reliable, and secure logistics solutions tailored to your business needs.</p>
                    <ul class="list-unstyled">
                        <li>✔ Fast and Secure Deliveries</li>
                        <li>✔ 24/7 Customer Support</li>
                        <li>✔ Industry Expertise</li>
                        <li>✔ Advanced Tracking Systems</li>
                        <li>✔ Global Network</li>
                    </ul>
                </div>
                <div class="col-md-6 mb-4">
                    <img src="/images/WhatsApp Image 2025-05-17 at 20.28.58.jpeg" class="img-fluid rounded shadow-lg" alt="Why Choose Us">
                </div>
            </div>
        </div>
    </section>



    <script src="/js/jquery-3.3.1.min.js"></script>
    <script src="/js/bootstrap.bundle.min.js"></script>
    <script src="/js/site.js"></script>
</body>
</html>