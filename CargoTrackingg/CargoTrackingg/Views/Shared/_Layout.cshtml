@{

    var role = Context.Session.GetString("Role") ?? "";
}


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CargoTrackingg</title>
    <link href="https://fonts.googleapis.com/css?family=Rubik:300,400,700|Oswald:400,700" rel="stylesheet">
    <link rel="stylesheet" href="~/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/css/jquery.fancybox.min.css">
    <link rel="stylesheet" href="~/css/owl.carousel.min.css">
    <link rel="stylesheet" href="~/css/owl.theme.default.min.css">
    <link rel="stylesheet" href="~/fonts/flaticon/font/flaticon.css">
    <link rel="stylesheet" href="~/css/aos.css">
    <link rel="stylesheet" href="~/css/style.css">
    <style>
        .notification-alert {
            position: fixed;
            top: 80px;
            right: 20px;
            z-index: 9999;
            min-width: 300px;
            max-width: 400px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
        }
    </style>
</head>
<body data-spy="scroll" data-target=".site-navbar-target" data-offset="300">

    <!-- Bildirim Mesajları -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show notification-alert" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show notification-alert" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="site-wrap" id="home-section">
        <div class="top-bar">
            <div class="container">
                <div class="row">
                    <div class="col-12">
                        <a href="#" class=""><span class="mr-2 icon-envelope-open-o"></span> <span class="d-none d-md-inline-block">info@jetcargo.com</span></a>
                        <span class="mx-md-2 d-inline-block"></span>
                        <a href="#" class=""><span class="mr-2 icon-phone"></span> <span class="d-none d-md-inline-block">1+ (234) 5678 9101</span></a>
                        <div class="float-right">
                            <a href="#" class=""><span class="mr-2 icon-twitter"></span> <span class="d-none d-md-inline-block">Twitter</span></a>
                            <span class="mx-md-2 d-inline-block"></span>
                            <a href="#" class=""><span class="mr-2 icon-facebook"></span> <span class="d-none d-md-inline-block">Facebook</span></a>
                            <span class="mx-md-2 d-inline-block"></span>
                            <div class="float-right">
    @if (User.Identity.IsAuthenticated)
    {

        <form method="post" asp-controller="Account" asp-action="Logout" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-sm btn-primary text-white">Log Out</button>
        </form>
    }
    else
    {
        <a href="/Account/Login" class="btn btn-sm btn-primary text-white">Log In</a>
        <a href="/Account/Register" class="btn btn-sm btn-outline-primary ml-2">Register</a>
    } 
</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (string.IsNullOrEmpty(role))
        {
            <!-- Giriş Yapmamış Kullanıcılar -->
            <header class="site-navbar js-sticky-header site-navbar-target" role="banner">
                <div class="container">
                    <div class="row align-items-center position-relative">
                        <div class="site-logo">
                            <a href="/" class="text-black"><span class="text-primary">JetCargo</span></a>
                        </div>
                        <div class="col-12">
                            <nav class="site-navigation text-right ml-auto" role="navigation">
                                <ul class="site-menu main-menu js-clone-nav ml-auto d-none d-lg-block">
                                    <li><a asp-controller="Home" asp-action="Index" class="nav-link">Home</a></li>
                                    <li><a asp-controller="Home" asp-action="Services" class="nav-link">Services</a></li>
                                    <li><a asp-controller="Home" asp-action="AboutUs" class="nav-link">About Us</a></li>
                                    <li><a asp-controller="Home" asp-action="WhyUs" class="nav-link">Why Us</a></li>
                                    <li><a asp-controller="Home" asp-action="Testimonials" class="nav-link">Testimonials</a></li>
                                    <li><a asp-controller="Home" asp-action="Blog" class="nav-link">Blog</a></li>
                                    <li><a asp-controller="Home" asp-action="Contact" class="nav-link">Contact</a></li>
                                </ul>
                            </nav>
                        </div>
                    </div>
                </div>
            </header>
        }
        else if (role == "Personnel")
        {
            <!-- Personnel Navbar -->
            <header class="site-navbar js-sticky-header site-navbar-target" role="banner">
                <div class="container">
                    <div class="row align-items-center position-relative">
                        <div class="site-logo">
                            <a href="/" class="text-black"><span class="text-primary">JetCargo</span></a>
                        </div>
                        <div class="col-12">
                            <nav class="site-navigation text-right ml-auto" role="navigation">
                                <ul class="site-menu main-menu js-clone-nav ml-auto d-none d-lg-block">
                                    <li><a asp-controller="Employee" asp-action="Orders" class="nav-link">Orders</a></li>
                                    <li><a asp-controller="Employee" asp-action="Profile" class="nav-link">Profile</a></li>
                                    <li><a asp-controller="Shipment" asp-action="Pending" class="nav-link">Pending Shipments</a></li>
                                    <li><a asp-controller="Shipment" asp-action="UpdateStatusByTracking" class="nav-link">UpdateStatus</a></li>
                                    <li><a asp-controller="Branch" asp-action="Create" class="nav-link">New Branch</a></li>
                                </ul>
                            </nav>
                        </div>
                    </div>
                </div>
            </header>
        }
        else if (role == "Customer")
        {
            <!-- Customer Navbar -->
            <header class="site-navbar js-sticky-header site-navbar-target" role="banner">
                <div class="container">
                    <div class="row align-items-center position-relative">
                        <div class="site-logo">
                            <a href="/" class="text-black"><span class="text-primary">JetCargo</span></a>
                        </div>
                        <div class="col-12">
                            <nav class="site-navigation text-right ml-auto" role="navigation">
                                <ul class="site-menu main-menu js-clone-nav ml-auto d-none d-lg-block">
                                    <li><a asp-controller="Customer" asp-action="CargoTracking" class="nav-link"> My Shipments</a></li>
                                    <li><a asp-controller="Shipment" asp-action="MyStatusHistory" class="nav-link">Status History</a></li>
                                    <li><a asp-controller="Shipment" asp-action="Create" class="nav-link">New Shipment Request</a></li>
                                    <li><a asp-controller="Customer" asp-action="Profile" class="nav-link">Profile</a></li>
                                    
                                </ul>
                            </nav>
                        </div>
                    </div>
                </div>
            </header>
        }



        @RenderBody()

    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            <p class="text-center">&copy; 2025 - CargoTrackingg - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a></p>
        </div>
    </footer>

    <script src="~/js/jquery-3.3.1.min.js"></script>
    <script src="~/js/popper.min.js"></script>
    <script src="~/js/bootstrap.min.js"></script>
    <script src="~/js/jquery.fancybox.min.js"></script>
    <script src="~/js/owl.carousel.min.js"></script>
    <script src="~/js/jquery.sticky.js"></script>
    <script src="~/js/jquery.waypoints.min.js"></script>
    <script src="~/js/jquery.animateNumber.min.js"></script>
    <script src="~/js/jquery.easing.1.3.js"></script>
    <script src="~/js/aos.js"></script>
    <script src="~/js/main.js"></script>
    <script>
        setTimeout(function () {
            const alerts = document.querySelectorAll('.notification-alert');
            alerts.forEach(function (alert) {
                const bootstrapAlert = new bootstrap.Alert(alert);
                bootstrapAlert.close();
            });
        }, 10000);
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>