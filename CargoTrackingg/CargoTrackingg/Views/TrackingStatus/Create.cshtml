@model CargoTrackingg.Models.TrackingStatus

<h2>Yeni Kargo Durumu Ekle</h2>

<form asp-action="Create">
    <div class="form-group">
        <label asp-for="TrackingNumber" class="control-label"></label>
        <input asp-for="TrackingNumber" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="StatusDescription" class="control-label"></label>
        <input asp-for="StatusDescription" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="StatusDate" class="control-label"></label>
        <input asp-for="StatusDate" class="form-control" type="datetime-local" />
    </div>
    <div class="form-group mt-2">
        <input type="submit" value="Kaydet" class="btn btn-primary" />
        <a asp-action="Index" class="btn btn-secondary">İptal</a>
    </div>
</form>
