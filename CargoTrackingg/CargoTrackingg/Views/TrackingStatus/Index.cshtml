@model IEnumerable<CargoTrackingg.Models.TrackingStatus>

<h2>Kargo Takip Durumları</h2>

<a asp-action="Create" class="btn btn-success mb-2">Yeni Durum Ekle</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Takip Numarası</th>
            <th>Durum</th>
            <th>Tarih</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.TrackingNumber</td>
                <td>@item.StatusDescription</td>
                <td>@item.StatusDate.ToString("g")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary btn-sm">Düzenle</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Sil</a>
                </td>
            </tr>
        }
    </tbody>
</table>
